   "source": [
    "# Plot water fall of time vs frequency channel\n",
    "\n",
    "with h5py.File(filename, \"r\") as f:\n",
    "    spectrum = f['scan/000/P0_ND0/spectrum'][:] # shape (666, 65537)\n",
    "    freq = f['scan/000/P0_ND0/frequency'][:] /1e6  # convert Hz -> MHz shape (65537,)\n",
    "    time = f['scan/000/P0_ND0/timestamp'][:,0]  # shape  (666,)\n",
    "\n",
    "# convert spectrum to dB\n",
    "spectrum = 10*np.log10(spectrum**2 + 1e-12)\n",
    "\n",
    "# convert time to UTC datetime\n",
    "time_utc = pd.to_datetime(time, unit=\"s\", utc=True)\n",
    "\n",
    "# create water fall plot\n",
    "plt.figure(figsize=(12,6))\n",
    "plt.imshow(\n",
    "    spectrum,\n",
    "    aspect='auto',\n",
    "    extent=[freq.min(), freq.max(), 0, spectrum.shape[0]], # to have freq on x-axis and time on y-axis\n",
    "    origin='lower',\n",
    "    cmap='viridis'\n",
    ")\n",
    "\n",
    "plt.xlabel('Frequency [MHz]')\n",
    "plt.ylabel('Time [s]')\n",
    "plt.title('Waterfall Plot: Time vs Frequency')\n",
    "plt.colorbar(label='Power [dB]')\n",
    "\n",
    "# --- fixed tick handling ---\n",
    "n_ticks = 15\n",
    "tick_positions = np.linspace(0, len(time_utc)-1, n_ticks, dtype=int)\n",
    "tick_labels = [time_utc[i].strftime(\"%Y-%m-%d %H:%M UTC\") for i in tick_positions]\n",
    "\n",
    "plt.yticks(tick_positions, tick_labels, rotation=0)\n",
    "\n"
   ]
