   "source": [
    "\n",
    "with h5py.File(filename, \"r\") as f:\n",
    "    # Example path to dataset (adjust if needed)\n",
    "    spectra = f[\"scan/000/P0_ND0/spectrum\"][:]   # shape (666, 65537)\n",
    "\n",
    "# Average over time (axis=0) → single mean spectrum in dB\n",
    "avg_spectrum = 10*np.log10(np.mean(spectra**2, axis=0))\n",
    "\n",
    "# Get frequency axis in MHz\n",
    "channel_width = 26702.880859375  # Hz (from your attributes)\n",
    "n_channels = spectra.shape[1]\n",
    "\n",
    "# Build frequency axis (starting at 0 for now)\n",
    "freqs = np.arange(n_channels) * channel_width / 1e6  # in MHz\n",
    "\n",
    "# Plot\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.scatter(freqs, avg_spectrum)\n",
    "plt.xlabel(\"Frequency [MHz]\")\n",
    "plt.ylabel(\"Power [dB]\")\n",
    "plt.title(\"Average Power Spectrum\")\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
