    "\n",
    "def mad(x):\n",
    "    return np.median(np.abs(x - np.median(x)))\n",
    "\n",
    "def characterize_rfi(freq_mhz, power_db,\n",
    "                     win=401, poly=3,      # baseline smoother (odd win)\n",
    "                     z_high=6.0, z_low=3.0,\n",
    "                     grow_iters=2,         # how far to dilate the mask\n",
    "                     min_width_chan=1,     # drop tiny one-bin blips if wanted\n",
    "                     merge_gap_chan=0):    # merge clusters separated by <= gap\n",
    "    freq_mhz = np.asarray(freq_mhz)\n",
    "    power_db = np.asarray(power_db)\n",
    "    assert freq_mhz.ndim == power_db.ndim == 1\n",
    "    assert len(freq_mhz) == len(power_db)\n",
    "\n",
    "    n = len(power_db)\n",
    "\n",
    "    # 1) Robust baseline (clip edges if win > n)\n",
    "    w = min(win if win % 2 else win+1, n - (1 - n % 2))  # ensure odd <= n\n",
    "    baseline = savgol_filter(power_db, w, poly, mode='interp')\n",
    "\n",
    "    # 2) Residuals\n",
    "    resid = power_db - baseline\n",
    "\n",
    "    # 3) Robust sigma via MAD\n",
    "    sigma = 1.4826 * mad(resid)\n",
    "    if not np.isfinite(sigma) or sigma == 0:\n",
    "        # fallback to std if MAD degenerates\n",
    "        sigma = np.std(resid)\n",
    "\n",
    "    # 4) Hysteresis thresholding\n",
    "    seeds = resid > (z_high * sigma)\n",
    "    mask = seeds.copy()\n",
    "    # region-grow down to z_low by dilating seeds and accepting dilated pixels above low thresh\n",
    "    low = resid > (z_low * sigma)\n",
    "    for _ in range(grow_iters):\n",
    "        mask = binary_dilation(mask) & low\n",
    "\n",
    "    # 5) Optional: merge very close clusters\n",
    "    idx = np.where(mask)[0]\n",
    "    if idx.size == 0:\n",
    "        # nothing flagged\n",
    "        out = {\n",
    "            \"mask\": mask,\n",
    "            \"num_corrupted_channels\": 0,\n",
    "            \"percent_corrupted\": 0.0,\n",
    "            \"total_corrupted_bandwidth_MHz\": 0.0,\n",
    "            \"clusters\": [],\n",
    "            \"baseline\": baseline,\n",
    "            \"sigma\": float(sigma)\n",
    "        }\n",
    "        return out\n",
    "\n",
    "    # Build contiguous runs\n",
    "    runs = []\n",
    "    start = idx[0]\n",
    "    prev = idx[0]\n",
    "    for k in idx[1:]:\n",
    "        if k == prev + 1:\n",
    "            prev = k\n",
    "        else:\n",
    "            runs.append([start, prev])\n",
    "            start = prev = k\n",
    "    runs.append([start, prev])\n",
    "\n",
    "    # Merge small gaps if requested\n",
    "    if merge_gap_chan > 0 and len(runs) > 1:\n",
    "        merged = [runs[0]]\n",
    "        for s, e in runs[1:]:\n",
    "            last_s, last_e = merged[-1]\n",
    "            if s - last_e - 1 <= merge_gap_chan:\n",
    "                merged[-1][1] = e\n",
    "            else:\n",
    "                merged.append([s, e])\n",
    "        runs = merged\n",
    "\n",
    "    # Drop very narrow runs if desired\n",
    "    runs = [r for r in runs if (r[1] - r[0] + 1) >= min_width_chan]\n",
    "\n",
    "    # Final mask from runs\n",
    "    mask[:] = False\n",
    "    for s, e in runs:\n",
    "        mask[s:e+1] = True\n",
    "\n",
    "    # Channel width estimate (assume nearly uniform)\n",
    "    df = np.median(np.diff(freq_mhz))\n",
    "    total_bw = mask.sum() * abs(df)\n",
    "\n",
    "    # Per-cluster summary\n",
    "    clusters = []\n",
    "    for s, e in runs:\n",
    "        sl = slice(s, e+1)\n",
    "        bw = (e - s + 1) * abs(df)\n",
    "        f_center = np.sum(freq_mhz[sl] * resid[sl]) / np.sum(resid[sl])  # weighted center\n",
    "        peak_i = s + np.argmax(power_db[sl])\n",
    "        clusters.append({\n",
    "            \"start_idx\": int(s),\n",
    "            \"end_idx\": int(e),\n",
    "            \"num_channels\": int(e - s + 1),\n",
    "            \"bandwidth_MHz\": float(bw),\n",
    "            \"f_min_MHz\": float(freq_mhz[s]),\n",
    "            \"f_max_MHz\": float(freq_mhz[e]),\n",
    "            \"f_center_MHz\": float(f_center),\n",
    "            \"peak_power_dB\": float(power_db[peak_i]),\n",
    "            \"peak_freq_MHz\": float(freq_mhz[peak_i])\n",
    "        })\n",
    "\n",
    "    out = {\n",
    "        \"mask\": mask,  # boolean array: True = corrupted\n",
    "        \"num_corrupted_channels\": int(mask.sum()),\n",
    "        \"percent_corrupted\": 100.0 * mask.mean(),\n",
    "        \"total_corrupted_bandwidth_MHz\": float(total_bw),\n",
    "        \"clusters\": clusters,\n",
    "        \"baseline\": baseline,\n",
    "        \"sigma\": float(sigma)\n",
    "    }\n",
    "    return out\n",
